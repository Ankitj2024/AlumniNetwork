# Where the Next.js server proxies /api/* (server-side)
API_URL=http://localhost:4000
# Where the browser opens the Socket.IO connection (defaults to <current host>:4000)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Show the one-tap demo account buttons on the sign-in page in a production build.
# They always show in development. Only enable for a hosted demo whose database has the demo data.
NEXT_PUBLIC_DEMO_LOGINS=false

# ── Public site facts (used by the footer, legal pages, SEO and the sitemap). Set before launch.
# The public URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Who runs the service, as named in the terms of service.
NEXT_PUBLIC_LEGAL_NAME=Your Organisation Pvt. Ltd.
# Shown on /contact and in the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
# City whose courts the terms name (e.g. Bengaluru).
NEXT_PUBLIC_JURISDICTION_CITY=
