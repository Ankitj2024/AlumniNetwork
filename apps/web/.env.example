# Where the Next.js server proxies /api/* (server-side)
API_URL=http://localhost:4000
# Where the browser opens the Socket.IO connection (defaults to <current host>:4000)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Show the one-tap demo account buttons on the sign-in page in a production build.
# They always show in development. Only enable for a hosted demo whose database has the demo data.
NEXT_PUBLIC_DEMO_LOGINS=false
